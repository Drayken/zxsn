---
import "@/css/global.css";
import type { ImageMetadata } from "astro";
import { SITE_TITLE } from "@/lib/consts";
import { Font } from "astro:assets";

interface Props {
  title: string;
  description: string;
  image?: ImageMetadata | undefined;
}

// `trailingSlash: "never"` keeps article links and their fragments in the
// canonical `/echoes/article#section` form. Normalize here as a safeguard for
// direct requests to a legacy slash-suffixed URL.
const canonicalPathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const canonicalURL = new URL(canonicalPathname, Astro.site);

const { title, description, image } = Astro.props;

const ogImageURL = image ? new URL(image.src, Astro.site) : new URL("/metadata/opengraph-image.png", Astro.site);
const twitterImageURL = image ? new URL(image.src, Astro.site) : new URL("/metadata/twitter-image.png", Astro.site);

const ogImageWidth = image?.width ?? 1200;
const ogImageHeight = image?.height ?? 600;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link rel="manifest" href="/metadata/manifest.webmanifest" />
<link rel="alternate" type="application/rss+xml" title={SITE_TITLE} href={new URL("rss.xml", Astro.site)} />
<meta name="generator" content={Astro.generator} />

<!-- Favicons -->
<link rel="shortcut icon" href="/metadata/favicon.ico" />
<link rel="icon" type="image/svg+xml" href="/metadata/icon.svg" />
<link rel="icon" type="image/png" sizes="96x96" href="/metadata/icon.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/metadata/apple-icon.png" />
<link rel="mask-icon" href="/metadata/icon.svg" color="#0a0a0a" />

<!-- Font preloads -->
<Font cssVariable="--font-noto-serif" preload />
<Font cssVariable="--font-noto-sans" preload />
<Font cssVariable="--font-noto-sans-mono" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />
<meta name="author" content="Drayken" />

<!-- Misc -->
<meta name="application-name" content={SITE_TITLE} />
<meta name="apple-mobile-web-app-title" content={SITE_TITLE} />
<meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
<meta name="color-scheme" content="light dark" />
<meta name="msapplication-TileColor" content="#0a0a0a" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="black" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImageURL} />
<meta property="og:image:width" content={String(ogImageWidth)} />
<meta property="og:image:height" content={String(ogImageHeight)} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@KGDrayken" />
<meta name="twitter:creator" content="@KGDrayken" />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={twitterImageURL} />
