---
import { getCollection } from "astro:content";
import Shell from "@/layouts/Shell.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";

const latest = (await getCollection("echoes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())[0];
const latestHref = latest ? `/echoes/${latest.id}` : "/echoes";
---

<Shell>
  <main class="relative flex grow flex-col items-center justify-center px-6 py-16 lg:items-start lg:px-12">
    <div class="z-1 text-center lg:text-left">
      <h1
        class="page-enter page-enter--0 mb-8 flex max-w-4xl translate-x-[-0.04em] flex-col items-center font-heading text-[clamp(2rem,5vw,5rem)] leading-tight lg:items-start">
        <span class="bg-background">Fragments</span>
        <span class="bg-background text-[clamp(1rem,4vw,3rem)] font-normal text-muted lg:font-light">of the</span>
        <span class="bg-background text-accent">Digital Frontier</span>
      </h1>
      <p class="page-enter page-enter--1 mb-16 max-w-md bg-background font-ui text-base text-muted lg:text-lg">
        Editorial Entropy by <a
          href="https://x.com/KGDrayken"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-accent hover:underline focus-visible:text-accent focus-visible:underline">KGDrayken</a
        >
      </p>
      <a
        href={latestHref}
        class="group ui-text page-enter page-enter--2 inline-flex items-center gap-2 bg-background py-1 text-lg text-foreground transition-colors duration-150 hover:border-transparent hover:bg-accent hover:text-background focus-visible:border-transparent focus-visible:bg-accent focus-visible:text-background">
        READ LATEST ECHO
        <ArrowUpRight
          class="-mb-0.5 size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-none motion-reduce:group-focus-visible:translate-none"
        />
      </a>
    </div>

    <!-- HERO ART -->
    <div class="page-enter-hero pointer-events-none absolute inset-0" aria-hidden="true">
      <div class="hero-mask hero-mask-base absolute inset-0 bg-foreground opacity-30"></div>
      <div class="hero-accent-flicker absolute inset-0">
        <div class="hero-mask hero-mask-accent absolute inset-0 bg-accent"></div>
      </div>
    </div>
    <div
      aria-hidden="true"
      class="page-enter-hero pointer-events-none absolute top-[30%] right-8 w-fit -translate-y-1/2">
      <div class="corner-border ui-text px-4 py-3 opacity-30 select-none">
        ORDER<br /> IS A MOMENT.<br /> ENTROPY<br /> IS THE STORY.
      </div>
    </div>
  </main>
</Shell>
