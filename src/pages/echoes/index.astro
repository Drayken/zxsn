---
import { getImage } from "astro:assets";
import { getCollection } from "astro:content";
import Shell from "@/layouts/Shell.astro";
import FormattedDate from "@/components/FormattedDate.astro";
import ArrowUpRight from "phosphor-astro/ArrowUpRight.astro";

const echoes = (await getCollection("echoes")).sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const [featured, ...rest] = echoes;

const featuredMask = featured
  ? (await getImage({ src: featured.data.heroImage, width: 1024, format: "webp" })).src
  : undefined;

const restMasks = await Promise.all(
  rest.map(async (echo) => ({
    echo,
    mask: (await getImage({ src: echo.data.heroImage, width: 1024, format: "webp" })).src,
  }))
);
---

<Shell>
  <main class="flex flex-col gap-8 px-6 py-16 lg:px-12">
    <h1 class="sr-only">Latest Echoes</h1>
    {
      featured && (
        <section class="grid gap-8 [grid-template-areas:'stack'] lg:grid-cols-2 lg:[grid-template-areas:'content_mask']">
          <div class="z-1 [grid-area:stack] lg:[grid-area:content]">
            <span class="page-enter page-enter--0 mb-2 block font-ui text-sm text-muted lg:text-base">
              <FormattedDate date={featured.data.pubDate} />
              {featured.data.updatedDate && (
                <>
                  {" "}
                  &bull; UPDATED <FormattedDate date={featured.data.updatedDate} />
                </>
              )}
            </span>
            <h2 class="page-enter page-enter--1 mb-8 max-w-3xl translate-x-[-0.04em] font-heading text-[clamp(2rem,5vw,4.5rem)] leading-tight">
              {featured.data.title}
            </h2>
            <p class="page-enter page-enter--2 mb-8 max-w-md font-ui text-lg">{featured.data.description}</p>
            <a
              href={`/echoes/${featured.id}`}
              class="group ui-text page-enter page-enter--3 inline-flex items-center gap-2 py-1 text-lg text-foreground transition-colors duration-150 hover:border-transparent hover:bg-accent hover:text-background focus-visible:border-transparent focus-visible:bg-accent focus-visible:text-background">
              READ ECHO
              <ArrowUpRight class="-mb-0.5 size-4 transition-transform duration-150 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 group-focus-visible:translate-x-0.5 group-focus-visible:-translate-y-0.5 motion-reduce:transition-none motion-reduce:group-hover:translate-none motion-reduce:group-focus-visible:translate-none" />
            </a>
          </div>
          <div class="page-enter-hero h-0 min-h-full w-full [grid-area:stack] lg:[grid-area:mask]" aria-hidden="true">
            <div
              class="luminance-mask h-full min-h-full w-full bg-foreground opacity-5 lg:opacity-100"
              style={`--mask: url(${featuredMask})`}
            />
          </div>
        </section>
      )
    }
    <div class="bg-dotted h-16 w-full" aria-hidden="true"></div>
    <section>
      <ul class="border-y">
        {
          restMasks.map(({ echo, mask }) => (
            <li class="relative grid grid-cols-[8rem_1fr] gap-8 not-last:border-b">
              <div
                class="luminance-mask h-full min-h-full w-full bg-foreground"
                style={`--mask: url(${mask}); --mask-size: cover; --mask-position: center`}
                aria-hidden="true"
              />
              <div class="py-8">
                <h3 class="mb-2">
                  <a
                    href={`/echoes/${echo.id}`}
                    class="font-heading text-[clamp(1rem,5vw,1.875rem)] hover:underline focus-visible:underline">
                    {echo.data.title}
                  </a>
                </h3>
                <span class="ui-text text-sm text-muted">
                  <FormattedDate date={echo.data.pubDate} />
                  {echo.data.updatedDate && (
                    <>
                      {" "}
                      &bull; UPDATED <FormattedDate date={echo.data.updatedDate} />
                    </>
                  )}
                </span>
              </div>
              <div
                class="luminance-mask pointer-events-none absolute inset-0 bg-foreground opacity-5"
                style={`--mask: url(${mask}); --mask-size: cover`}
                aria-hidden="true"
              />
            </li>
          ))
        }
      </ul>
    </section>
  </main>
</Shell>
